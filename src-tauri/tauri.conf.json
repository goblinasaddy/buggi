{
  "build": {
    "distDir": "../frontend/out",
    "devPath": "http://localhost:3000",
    "beforeDevCommand": "npm run frontend:dev",
    "beforeBuildCommand": "npm run frontend:build"
  },
  "package": {
    "productName": "Buggi",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": true
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.buggi.app",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "pet",
        "title": "Buggi Pet",
        "url": "/pet",
        "width": 90,
        "height": 100,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "visible": true
      },
      {
        "label": "main",
        "title": "Buggi Cybersecurity Command Center",
        "url": "/",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "decorations": true,
        "center": true,
        "visible": false
      }
    ]
  }
}
